{
  "expo": {
    "name": "Kinlo",
    "slug": "kinlo",
    "scheme": "kinlo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/6f764e9d-b9ca-41f2-b288-f5738705ceb9",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinlo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kinlo.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Kinlo uses your contacts so you can add friends by picking them from your phone instead of typing their name and number by hand. Your contacts are read on your device only and are never uploaded."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#004c22"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f764e9d-b9ca-41f2-b288-f5738705ceb9"
      }
    }
  }
}
