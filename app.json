{
  "expo": {
    "name": "Kinlo",
    "slug": "kinlo",
    "scheme": "kinlo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/6f764e9d-b9ca-41f2-b288-f5738705ceb9",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinlo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kinlo.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Kinlo uses your contacts in two ways. When you add a friend, you pick one contact and only that person is used. If you turn on contact sync, Kinlo also checks your contacts against people who already use Kinlo so it can suggest them — for that, phone numbers from your contacts are sent to Kinlo's servers to look for matches. You can turn contact sync off any time in your Profile."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#004c22"
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["image/*"],
            "multipleShareMimeTypes": ["image/*"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinlo needs access to your photos so you can pick a payment screenshot to scan into an expense.",
          "cameraPermission": "Kinlo needs camera access so you can photograph a receipt to scan into an expense."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f764e9d-b9ca-41f2-b288-f5738705ceb9"
      }
    }
  }
}
