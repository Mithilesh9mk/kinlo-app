# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets and signing/service credentials (never commit)
*.keystore
google-services.json
GoogleService-Info.plist
service-account*.json
.claude/settings.local.json
.npmrc

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (any .env variant; only the template is committed)
.env
.env*
!.env.example

# build outputs (APKs are published as GitHub Release assets, not committed)
*.apk
*.aab

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Internal working docs: kept on the owner's machine, not published
/CLAUDE.md
/edge_cases_analysis.md
/docs/*.docx
/docs/GOLD_PLAN.md
/docs/Kinlo-Security-Fixes-*.md
/docs/ONBOARDING_AUDIT.md
/docs/PRODUCTION-READINESS.md
/docs/PROJECT_STATUS.md
/docs/PROJECT_STATUS_ARCHIVE.md
/docs/SESSION_HANDOVER_*.md
/docs/TASKS.md
/docs/kinlo-3d-knowledge-graph.html
/docs/sql/
/supabase/PROVISION.md
