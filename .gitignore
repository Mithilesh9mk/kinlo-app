# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets and signing/service credentials (never commit)
*.keystore
google-services.json
GoogleService-Info.plist
service-account*.json
.claude/settings.local.json
.npmrc

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (any .env variant; only the template is committed)
.env
.env*
!.env.example

# build outputs (APKs are published as GitHub Release assets, not committed)
*.apk
*.aab

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
