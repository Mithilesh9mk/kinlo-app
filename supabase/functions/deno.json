{
  "lock": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.window", "esnext"]
  },
  "tasks": {
    "check": "deno check --all push-notify/index.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
