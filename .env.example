# Kinlo — environment variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#   cp .env.example .env
#
# Find these in the Supabase dashboard under Project Settings → API.

# ---------------------------------------------------------------------------
# App (Expo) — EXPO_PUBLIC_ vars are bundled into the client build.
# Only ever put values here that are safe to ship to a device: the anon key is
# safe *because* RLS restricts it (see supabase/migrations/0002_user_isolation.sql).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# Local admin/debug scripts only (check-*.mjs, create-rpc.mjs, reset-pass.mjs,
# auto-verify.mjs). These read .env directly via fs.readFileSync.
#
# The service role key bypasses RLS entirely — it must never be prefixed with
# EXPO_PUBLIC_, never be imported by anything under app/ or lib/, and never
# leave a developer machine.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# Edge functions (supabase/functions/*) do NOT read this file. Supabase injects
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY into the
# function runtime automatically. push-notify depends on all three — the anon
# key is what lets it build a caller-scoped client so RLS decides who may be
# notified. Verify they are present with:
#   supabase secrets list
#
# parse-receipt needs either an ANTHROPIC_API_KEY (Claude vision) or GEMINI_API_KEY
# secret, set in Supabase:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-your-key-here
# Or:
#   supabase secrets set GEMINI_API_KEY=your-gemini-key-here
# Optional: RECEIPT_MODEL overrides the extraction model (e.g. claude-3-5-sonnet-20241022
# or gemini-3.6-flash).
# ---------------------------------------------------------------------------
